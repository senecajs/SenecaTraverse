{
  "name": "@seneca/traverse",
  "version": "0.2.0",
  "main": "dist/Traverse.js",
  "type": "commonjs",
  "types": "dist/Traverse.d.ts",
  "description": "Data Traverse plugin for the Seneca framework.",
  "homepage": "https://github.com/senecajs/SenecaTraverse",
  "keywords": [
    "seneca",
    "Traverse"
  ],
  "author": "Leonardo Cunha - leonardocunha.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/SenecaTraverse.git"
  },
  "scripts": {
    "prettier": "prettier --write .",
    "test": "node --enable-source-maps --test \"dist-test/**/*.test.js\"",
    "test-some": "node --enable-source-maps --test-name-pattern=\"$TEST_PATTERN\" --test \"dist-test/**/*.test.js\"",
    "watch": "tsc --build src test -w",
    "build": "tsc --build src test",
    "doc": "seneca-doc",
    "clean": "rm -rf dist dist-test node_modules yarn.lock package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test"
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src/**/*.ts",
    "LICENSE",
    "README.md",
    "CHANGES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@hapi/code": "^9.0.3",
    "@seneca/doc": "^9.0.0",
    "@seneca/entity": "^29.0.0",
    "@types/node": "^24.0.0",
    "prettier": "3.8.4",
    "seneca": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@seneca/entity": "^29.0.0",
    "seneca": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
